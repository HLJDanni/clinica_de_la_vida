# Conexión a PostgreSQL (local con docker-compose, o Neon/Supabase en producción)
# Neon ejemplo: postgres://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/clinica?sslmode=require
DATABASE_URL=postgres://clinica:clinica_dev@localhost:5439/clinica

# Secreto para firmar sesiones (mínimo 32 caracteres, aleatorio)
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio-de-64-caracteres

PORT=4000
NODE_ENV=development

# Contraseñas iniciales de los dos únicos usuarios (se aplican al ejecutar db:seed)
DOCTOR_PASSWORD="Delia#Vida2026"
RECEPTION_PASSWORD="Recepcion#2026"
